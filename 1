from selenium import webdriver
from selenium.webdriver.common.by import By
from selenium.webdriver.support.ui import WebDriverWait
from selenium.webdriver.support import expected_conditions as EC

driver = webdriver.Edge()
wait = WebDriverWait(driver, timeout=10)
try:
      driver.get("https://practice.expandtesting.com/inputs")
    #在**数字输入框**填入数字 `6688`
      num_input = wait.until(EC.element_to_be_clickable((By.XPATH, '//input[@id="input-number"]')))
      num_input.send_keys("6688")
    #点击`Submit`提交按钮
      submit_btn = wait.until(EC.element_to_be_clickable((By.XPATH, "//button[contains(text(),'Display Inputs')]")))
      submit_btn.click()
    #使用显式等待，等待结果区域出现输出内容
      wait.until(EC.presence_of_element_located((By.XPATH, "//*[contains(text(),'6688')]")))
    #断言页面输出结果包含字符串 `6688`
      assert "6688" in driver.page_source
      print("test finishes")
finally:
      driver.quit()
      print("web browser closed")

#测试成功
